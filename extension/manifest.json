{
  "manifest_version": 3,
  "name": "RecallCard 会话与上下文",
  "version": "0.3.1",
  "description": "主动读取 ChatGPT / DeepSeek 当前可见会话，选择后保存或导出，为另一个 AI 准备上下文。最终发送始终由你完成。",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecallCard 会话与上下文"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.z.ai/*"
      ],
      "js": [
        "site-adapters.js",
        "composer-adapter.js",
        "conversation-format.js",
        "conversation-adapters.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
