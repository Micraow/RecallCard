{
  "name": "recallcard-desktop-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test:frontend": "playwright test --config frontend/playwright.config.ts",
    "test:contracts": "node --experimental-strip-types --test frontend/tests/contracts.test.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "version": "0.6.0-dev"
}
